# ASTROSAGE Local & Offline Configuration
# Bind host: use 127.0.0.1 for strict local-only laptop deployment, or 0.0.0.0 in container environments
ASTROSAGE_HOST="0.0.0.0"
PORT="3000"
APP_URL="http://localhost:3000"

# Local SQLite database path
ASTROSAGE_DB_PATH="data/astrosage.db"

# Local Ollama configuration (optional; application provides deterministic retrieval fallback when offline/unavailable)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_MS="25000"
